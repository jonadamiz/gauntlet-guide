  "94": {
   "id": 94,
   "name": "Cripple",
   "handler": "Skill_Tj_End",
   "lua": "1 + (sklv * 0.05) * Atk_Dmg(atker, defer)",
   "js": "1 + (L * 0.05) * ATK",
   "usesAspd": false,
   "magic": false,
   "alternates": [],
   "conditions": [],
   "note": "Reads `1 + (sklv * k) * Atk_Dmg`, so the +1 sits OUTSIDE the multiplier -- at Lv10 this is about half a normal attack. Every sibling skill brackets the whole term. Shown as shipped."
  },
